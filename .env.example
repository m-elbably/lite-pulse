# Server configuration
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Optional: enable session-based auth for the admin UI + admin APIs
# Leave both unset to disable authentication in local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: credentials for the status page (dashboard)
# Only used when PUBLIC_STATUS_PAGE=false
STATUS_USERNAME=viewer
STATUS_PASSWORD=change-me

# Set to true to make the status page publicly accessible without login
PUBLIC_STATUS_PAGE=false

# Secret used to sign session tokens (generate a long random string for production)
SESSION_SECRET=change-this-to-a-long-random-secret

DATA_RETENTION_DAYS=30

# Database configuration
DB_ADAPTER=mongodb
MONGODB_URI=mongodb://localhost:27017/lite-pulse
SQLITE_PATH=./uptime.db

# MongoDB-only options
MONGO_USE_CAPPED=false
MONGO_CAPPED_SIZE_MB=256

# Email configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=yourpassword
SMTP_FROM=alerts@example.com
