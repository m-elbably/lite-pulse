{
  "name": "vigil",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run build:web && bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "bun x tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "bun test tests/backend/*.test.ts tests/web/*.test.ts",
    "build": "bun run build:web && bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.14",
    "lucide-vue-next": "^1.0.0",
    "mongodb": "^7.1.1",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.22",
    "vue-router": "^4.6.2",
    "vue-sonner": "^2.0.9",
    "zod": "^4.3.6"
  }
}
